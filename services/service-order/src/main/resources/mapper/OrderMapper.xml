<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.order.mapper.OrderMapper">

    <insert id="insertRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO b_order
            (`customer_id`,`product_id`,`amount`,`order_date`)
        VALUES
            (#{customerId},#{productId},#{amount},NOW())
    </insert>
    <select id="selectAll" resultType="com.order.entity.Order">
        SELECT
            *
        FROM
            b_order
    </select>
    <select id="selectById2" resultType="order.dto.OrderDTO">
        SELECT
            *
        FROM
            b_order
        WHERE
            id = #{id}
    </select>
</mapper>