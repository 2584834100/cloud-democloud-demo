<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.product.mapper.ProductMapper">

    <!--    &lt;!&ndash; 根据 ID 查询产品 &ndash;&gt;-->
<!--    <select id="selecsstById" resultType="com.product.entity.Product">-->
<!--        SELECT * FROM product WHERE id = #{id}-->
<!--    </select>-->
    <select id="selectByName" resultType="com.product.entity.Product">
        SELECT
            *
        FROM
            product
        WHERE
            name = #{name}
    </select>

    <update id="updateStock" >
        UPDATE product
            SET stock = #{stock}
        WHERE
            id = #{id}
    </update>

</mapper>